<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Qalb-e-Deen — The Heart of Deen</title>

  <meta name="description"
    content="Qalb-e-Deen — Islamic knowledge, Quran, Hadith, Dua, Ramadan and Islamic lifestyle.">

  <style>
    :root{
      --green:#063f35;
      --green2:#0b594a;
      --deep:#032c26;
      --gold:#c99a3a;
      --gold2:#e8c66a;
      --cream:#f7f4ec;
      --paper:#fffdf8;
      --text:#18322d;
      --muted:#70807b;
      --line:#e9e5da;
      --shadow:0 10px 30px rgba(2,40,34,.08);
      --radius:18px;
    }

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:"Noto Sans Bengali","Hind Siliguri",system-ui,sans-serif;
      background:var(--cream);
      color:var(--text);
      line-height:1.65;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    img{
      max-width:100%;
      display:block;
    }

    button,
    input{
      font:inherit;
    }

    .container{
      width:min(1180px,92%);
      margin:auto;
    }

    /* =========================
       HEADER
    ========================= */

    header{
      background:rgba(3,44,38,.98);
      color:#fff;
      position:sticky;
      top:0;
      z-index:1000;
      box-shadow:0 5px 20px rgba(0,0,0,.12);
    }

    .nav{
      height:76px;
      display:flex;
      align-items:center;
      gap:30px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      margin-right:auto;
    }

    .logo-mark{
      width:48px;
      height:48px;
      border:2px solid var(--gold2);
      border-radius:14px 14px 20px 20px;
      display:grid;
      place-items:center;
      position:relative;
      background:linear-gradient(145deg,#0a6756,#04382f);
    }

    .logo-mark:before{
      content:"☪";
      font-size:25px;
      color:var(--gold2);
      position:absolute;
      top:2px;
    }

    .logo-book{
      font-size:24px;
      margin-top:11px;
      color:#fff;
    }

    .brand h1{
      font-family:Georgia,serif;
      font-size:24px;
      line-height:1;
      color:#fff;
    }

    .brand small{
      color:#d8c18a;
      font-size:11px;
      letter-spacing:1px;
    }

    nav{
      display:flex;
      gap:24px;
      align-items:center;
    }

    nav a{
      font-size:14px;
      color:#eef7f3;
      transition:.2s;
    }

    nav a:hover,
    nav a.active{
      color:var(--gold2);
    }

    .nav-actions{
      display:flex;
      gap:10px;
      align-items:center;
    }

    .icon-btn{
      width:38px;
      height:38px;
      border:1px solid rgba(255,255,255,.18);
      border-radius:50%;
      background:transparent;
      color:#fff;
      cursor:pointer;
      display:grid;
      place-items:center;
    }

    .icon-btn:hover{
      background:rgba(255,255,255,.08);
    }

    .menu{
      display:none;
    }

    /* =========================
       PROFILE
    ========================= */

    .profile-area{
      position:relative;
    }

    .profile-btn{
      width:40px;
      height:40px;
      border-radius:50%;
      overflow:hidden;
      border:2px solid var(--gold2);
      background:#0b594a;
      cursor:pointer;
      display:grid;
      place-items:center;
      color:#fff;
      font-weight:700;
      padding:0;
    }

    .profile-btn img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .profile-initial{
      font-size:17px;
    }

    .profile-menu{
      position:absolute;
      right:0;
      top:52px;
      width:260px;
      background:#fff;
      color:var(--text);
      border-radius:16px;
      box-shadow:0 15px 40px rgba(0,0,0,.22);
      padding:18px;
      display:none;
      z-index:2000;
      border:1px solid var(--line);
    }

    .profile-menu.open{
      display:block;
      animation:profileOpen .18s ease;
    }

    @keyframes profileOpen{
      from{
        opacity:0;
        transform:translateY(-5px);
      }
      to{
        opacity:1;
        transform:translateY(0);
      }
    }

    .profile-top{
      text-align:center;
      padding-bottom:15px;
      border-bottom:1px solid var(--line);
      margin-bottom:14px;
    }

    .profile-large{
      width:70px;
      height:70px;
      margin:0 auto 10px;
      border-radius:50%;
      overflow:hidden;
      border:3px solid var(--gold2);
      background:#e7f2ed;
      display:grid;
      place-items:center;
      color:var(--green2);
      font-size:25px;
      font-weight:800;
    }

    .profile-large img{
      width:100%;
      height:100%;
      object-fit:cover;
    }

    .profile-name{
      font-weight:800;
      color:var(--deep);
      font-size:16px;
    }

    .profile-email{
      font-size:11px;
      color:var(--muted);
      word-break:break-word;
      margin-top:2px;
    }

    .profile-menu label{
      display:block;
      font-size:12px;
      font-weight:700;
      margin-bottom:7px;
      color:var(--deep);
    }

    .profile-menu input[type="file"]{
      width:100%;
      font-size:11px;
      margin-bottom:10px;
      color:var(--muted);
    }

    .profile-menu button.action{
      width:100%;
      border:0;
      padding:10px;
      border-radius:9px;
      cursor:pointer;
      margin-top:6px;
      font-weight:700;
    }

    .upload-btn{
      background:var(--green);
      color:#fff;
    }

    .upload-btn:hover{
      background:var(--green2);
    }

    .login-btn{
      background:var(--gold2);
      color:#17362f;
    }

    .logout-btn{
      background:#f0f0ed;
      color:#333;
    }

    .upload-status{
      font-size:11px;
      color:var(--muted);
      margin-top:7px;
      text-align:center;
      min-height:17px;
    }

    /* =========================
       HERO
    ========================= */

    .hero{
      min-height:450px;
      display:flex;
      align-items:center;
      background:
        linear-gradient(
          90deg,
          rgba(2,42,35,.96) 0%,
          rgba(2,42,35,.80) 42%,
          rgba(2,42,35,.25) 75%
        ),
        url("https://images.unsplash.com/photo-1519817650390-64a93db51149?auto=format&fit=crop&w=1800&q=85")
        center/cover;
      color:#fff;
    }

    .hero-inner{
      padding:70px 0;
      width:min(650px,100%);
    }

    .eyebrow{
      display:inline-block;
      background:var(--gold);
      color:#fff;
      padding:5px 13px;
      border-radius:20px;
      font-size:13px;
      margin-bottom:14px;
    }

    .hero h2{
      font-family:Georgia,"Noto Serif Bengali",serif;
      font-size:clamp(34px,5vw,58px);
      line-height:1.18;
      margin-bottom:16px;
    }

    .hero p{
      font-size:17px;
      color:#edf5f1;
      max-width:590px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      gap:8px;
      background:var(--gold2);
      color:#17362f;
      border:0;
      padding:12px 20px;
      border-radius:10px;
      font-weight:700;
      margin-top:24px;
      cursor:pointer;
      transition:.2s;
    }

    .btn:hover{
      transform:translateY(-1px);
      filter:brightness(1.04);
    }

    /* =========================
       CATEGORIES
    ========================= */

    .categories{
      padding:28px 0;
      background:#fff;
    }

    .cat-grid{
      display:grid;
      grid-template-columns:repeat(8,1fr);
      gap:12px;
    }

    .cat{
      background:#fbfaf5;
      border:1px solid var(--line);
      border-radius:14px;
      padding:15px 8px;
      text-align:center;
      transition:.2s;
    }

    .cat:hover{
      transform:translateY(-3px);
      box-shadow:var(--shadow);
    }

    .cat-icon{
      width:45px;
      height:45px;
      border-radius:50%;
      display:grid;
      place-items:center;
      margin:0 auto 8px;
      background:#e6f2ec;
      color:var(--green2);
      font-size:21px;
    }

    .cat:nth-child(even) .cat-icon{
      background:#f7edcf;
      color:#a67920;
    }

    .cat span{
      font-size:12px;
      font-weight:700;
    }

    /* =========================
       MAIN
    ========================= */

    main{
      padding:48px 0;
    }

    .section-head{
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:20px;
    }

    .section-head h3{
      font-family:Georgia,"Noto Serif Bengali",serif;
      font-size:28px;
      color:var(--deep);
    }

    .section-head a{
      color:var(--green2);
      font-weight:700;
      font-size:14px;
    }

    .layout{
      display:grid;
      grid-template-columns:1fr 330px;
      gap:28px;
    }

    .post-card{
      background:var(--paper);
      border:1px solid var(--line);
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
    }

    .featured{
      display:grid;
      grid-template-columns:45% 55%;
      margin-bottom:18px;
    }

    .featured img{
      height:100%;
      min-height:280px;
      object-fit:cover;
    }

    .post-body{
      padding:28px;
    }

    .tag{
      display:inline-block;
      background:#e7f2ed;
      color:var(--green2);
      padding:4px 10px;
      border-radius:15px;
      font-size:12px;
      font-weight:700;
      margin-bottom:10px;
    }

    .post-body h4{
      font-family:Georgia,"Noto Serif Bengali",serif;
      font-size:25px;
      line-height:1.35;
      margin-bottom:10px;
    }

    .post-body p{
      color:var(--muted);
      font-size:14px;
    }

    .meta{
      display:flex;
      gap:15px;
      color:#88928f;
      font-size:12px;
      margin-top:16px;
    }

    .post-list{
      display:grid;
      gap:12px;
    }

    .list-card{
      display:grid;
      grid-template-columns:170px 1fr;
      background:var(--paper);
      border:1px solid var(--line);
      border-radius:15px;
      overflow:hidden;
    }

    .list-card img{
      height:135px;
      width:170px;
      object-fit:cover;
    }

    .list-card .post-body{
      padding:17px 20px;
    }

    .list-card h4{
      font-size:18px;
    }

    /* =========================
       SIDEBAR
    ========================= */

    .side{
      display:grid;
      gap:18px;
      align-content:start;
    }

    .widget{
      background:var(--paper);
      border:1px solid var(--line);
      border-radius:16px;
      padding:20px;
      box-shadow:var(--shadow);
    }

    .widget h4{
      font-size:17px;
      margin-bottom:14px;
      color:var(--deep);
    }

    .search{
      display:flex;
      border:1px solid var(--line);
      border-radius:10px;
      overflow:hidden;
      background:#fff;
    }

    .search input{
      border:0;
      outline:0;
      padding:12px;
      width:100%;
      font:inherit;
    }

    .search button{
      width:50px;
      border:0;
      background:var(--green);
      color:#fff;
      cursor:pointer;
    }

    .quote{
      text-align:center;
      background:linear-gradient(145deg,#fffaf0,#f6efdc);
      border-color:#e8d8ae;
    }

    .quote .arabic{
      font-family:serif;
      font-size:24px;
      color:#9b7425;
      margin:8px 0;
    }

    .newsletter{
      background:var(--green);
      color:#fff;
    }

    .newsletter h4{
      color:#fff;
    }

    .newsletter p{
      font-size:13px;
      color:#d9ebe5;
    }

    .newsletter input{
      width:100%;
      padding:11px;
      border-radius:9px;
      border:0;
      margin-top:12px;
      outline:0;
    }

    .newsletter .btn{
      width:100%;
      justify-content:center;
      margin-top:10px;
    }

    .popular{
      display:grid;
      gap:12px;
    }

    .popular-item{
      display:grid;
      grid-template-columns:65px 1fr;
      gap:10px;
      align-items:center;
    }

    .popular-item img{
      width:65px;
      height:50px;
      border-radius:8px;
      object-fit:cover;
    }

    .popular-item strong{
      font-size:13px;
      line-height:1.3;
    }

    .socials{
      display:flex;
      gap:9px;
    }

    .socials a{
      width:38px;
      height:38px;
      border-radius:10px;
      background:#edf3f0;
      display:grid;
      place-items:center;
      color:var(--green);
      font-weight:800;
    }

    /* =========================
       QURAN STRIP
    ========================= */

    .quran-strip{
      margin-top:48px;
      border-radius:22px;
      overflow:hidden;
      min-height:230px;
      display:flex;
      align-items:center;
      padding:35px;
      background:
        linear-gradient(
          90deg,
          rgba(3,50,42,.94),
          rgba(3,50,42,.48)
        ),
        url("https://images.unsplash.com/photo-1609599006353-e629aaabfeae?auto=format&fit=crop&w=1500&q=85")
        center/cover;
      color:#fff;
    }

    .quran-strip h3{
      font-family:Georgia,serif;
      font-size:28px;
      color:#f4d98a;
    }

    .quran-strip p{
      max-width:650px;
      margin-top:8px;
      color:#eaf3ef;
    }

    /* =========================
       FOOTER
    ========================= */

    footer{
      background:#032c26;
      color:#d9e9e4;
      margin-top:50px;
    }

    .footer-main{
      padding:45px 0;
      display:grid;
      grid-template-columns:1.5fr 1fr 1fr 1fr;
      gap:35px;
    }

    .footer-brand p{
      margin-top:12px;
      color:#a9c2bb;
      font-size:13px;
      max-width:360px;
    }

    footer h4{
      color:#f1d17b;
      margin-bottom:12px;
    }

    footer li{
      list-style:none;
      margin:7px 0;
      font-size:13px;
      color:#b9ccc6;
    }

    .copyright{
      border-top:1px solid rgba(255,255,255,.1);
      padding:16px 0;
      text-align:center;
      font-size:12px;
      color:#91aaa3;
    }

    /* =========================
       MOBILE
    ========================= */

    @media(max-width:950px){

      nav{
        display:none;
      }

      .menu{
        display:grid;
      }

      .cat-grid{
        grid-template-columns:repeat(4,1fr);
      }

      .layout{
        grid-template-columns:1fr;
      }

      .side{
        grid-template-columns:repeat(2,1fr);
      }

      .footer-main{
        grid-template-columns:repeat(2,1fr);
      }
    }

    @media(max-width:650px){

      .nav{
        height:68px;
        gap:7px;
      }

      .brand h1{
        font-size:19px;
      }

      .brand small{
        font-size:9px;
      }

      .logo-mark{
        width:40px;
        height:40px;
      }

      .nav-actions{
        gap:6px;
      }

      .icon-btn{
        width:35px;
        height:35px;
      }

      .profile-btn{
        width:37px;
        height:37px;
      }

      .profile-menu{
        right:-5px;
        width:250px;
      }

      .hero{
        min-height:510px;
      }

      .hero-inner{
        padding:55px 0;
      }

      .hero h2{
        font-size:36px;
      }

      .hero p{
        font-size:14px;
      }

      .cat-grid{
        grid-template-columns:repeat(4,1fr);
        gap:7px;
      }

      .cat{
        padding:10px 3px;
      }

      .cat-icon{
        width:38px;
        height:38px;
        font-size:18px;
      }

      .cat span{
        font-size:10px;
      }

      main{
        padding:32px 0;
      }

      .featured{
        display:block;
      }

      .featured img{
        height:230px;
        min-height:0;
      }

      .post-body{
        padding:20px;
      }

      .post-body h4{
        font-size:21px;
      }

      .list-card{
        grid-template-columns:100px 1fr;
      }

      .list-card img{
        width:100px;
        height:105px;
      }

      .list-card .post-body{
        padding:12px;
      }

      .list-card h4{
        font-size:15px;
      }

      .list-card p{
        display:none;
      }

      .meta{
        font-size:10px;
        gap:8px;
      }

      .side{
        grid-template-columns:1fr;
      }

      .footer-main{
        grid-template-columns:1fr;
      }

      .quran-strip{
        padding:25px;
        min-height:280px;
      }
    }

    /* =========================
       MOBILE MENU
    ========================= */

    .mobile-nav{
      display:none;
      background:#063f35;
      padding:10px 4%;
      border-top:1px solid rgba(255,255,255,.1);
    }

    .mobile-nav a{
      display:block;
      padding:10px;
      color:#fff;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .mobile-nav.open{
      display:block;
    }

    /* =========================
       DARK MODE
    ========================= */

    body.dark-mode{
      background:#071e1a;
      color:#e9f2ee;
    }

    body.dark-mode .categories,
    body.dark-mode .post-card,
    body.dark-mode .widget{
      background:#0b2923;
      border-color:#19443a;
    }

    body.dark-mode .cat{
      background:#0b2923;
      border-color:#19443a;
    }

    body.dark-mode .section-head h3,
    body.dark-mode .widget h4{
      color:#e9f2ee;
    }

    body.dark-mode .post-body p,
    body.dark-mode .meta{
      color:#a9c2bb;
    }

    body.dark-mode .search{
      background:#102e28;
      border-color:#19443a;
    }

    body.dark-mode .search input{
      background:#102e28;
      color:#fff;
    }
  </style>
</head>

<body>

<!-- =========================
     HEADER
========================= -->

<header>

  <div class="container nav">

    <a href="#" class="brand">

      <div class="logo-mark">
        <span class="logo-book">⌁</span>
      </div>

      <div>
        <h1>Qalb-e-Deen</h1>
        <small>The Heart of Deen</small>
      </div>

    </a>

    <nav>

      <a class="active" href="#">হোম</a>
      <a href="#quran">কুরআন ও তাফসির</a>
      <a href="#posts">হাদিস</a>
      <a href="#posts">দোয়া ও আমল</a>
      <a href="#posts">রমজান</a>
      <a href="#posts">আরও⌄</a>

    </nav>

    <div class="nav-actions">

      <!-- PROFILE -->

      <div class="profile-area">

        <button
          class="profile-btn"
          onclick="toggleProfileMenu()"
          aria-label="Profile"
        >

          <span
            id="profileInitial"
            class="profile-initial"
          >👤</span>

          <img
            id="profileImage"
            src=""
            alt="Profile"
            style="display:none;"
          >

        </button>

        <div
          class="profile-menu"
          id="profileMenu"
        >

          <!-- LOGGED IN -->

          <div id="loggedInArea" style="display:none;">

            <div class="profile-top">

              <div class="profile-large">

                <span id="profileLargeInitial">
                  👤
                </span>

                <img
                  id="profileLargeImage"
                  src=""
                  alt="Profile"
                  style="display:none;"
                >

              </div>

              <div
                class="profile-name"
                id="profileName"
              >
                User
              </div>

              <div
                class="profile-email"
                id="profileEmail"
              >
              </div>

            </div>

            <label for="profileFile">
              Profile Picture
            </label>

            <input
              type="file"
              id="profileFile"
              accept="image/jpeg,image/png,image/webp"
            >

            <button
              class="action upload-btn"
              onclick="uploadProfilePicture()"
            >
              📸 Upload Profile Picture
            </button>

            <div
              class="upload-status"
              id="uploadStatus"
            ></div>

            <button
              class="action logout-btn"
              onclick="logoutUser()"
            >
              🚪 Logout
            </button>

          </div>

          <!-- LOGGED OUT -->

          <div id="loggedOutArea">

            <div class="profile-top">

              <div class="profile-large">
                👤
              </div>

              <div class="profile-name">
                Guest User
              </div>

              <div class="profile-email">
                Login করে profile তৈরি করুন
              </div>

            </div>

            <button
              class="action login-btn"
              onclick="goToLogin()"
            >
              🔐 Login / Sign Up
            </button>

          </div>

        </div>

      </div>

      <!-- SEARCH -->

      <button
        class="icon-btn"
        onclick="focusSearch()"
        aria-label="Search"
      >
        ⌕
      </button>

      <!-- THEME -->

      <button
        class="icon-btn"
        onclick="toggleTheme()"
        aria-label="Theme"
      >
        ☾
      </button>

      <!-- MOBILE MENU -->

      <button
        class="icon-btn menu"
        onclick="toggleMenu()"
        aria-label="Menu"
      >
        ☰
      </button>

    </div>

  </div>

  <!-- MOBILE NAV -->

  <div
    id="mobileNav"
