<script type="module">

  import {
    initializeApp
  }
  from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";


  import {
    getFirestore,
    collection,
    query,
    where,
    limit,
    getDocs,
    doc,
    setDoc,
    getDoc
  }
  from "https://www.gstatic.com/firebasejs/12.19.0/firebase-firestore.js";


  import {
    getAuth,
    onAuthStateChanged,
    signOut
  }
  from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";


  import {
    getStorage,
    ref,
    uploadBytes,
    getDownloadURL
  }
  from "https://www.gstatic.com/firebasejs/12.19.0/firebase-storage.js";


  /* =========================
     FIREBASE CONFIG
  ========================= */

  const firebaseConfig = {

    apiKey:
      "AIzaSyDQoJKtyi3BqBPehwKDemmSgXf9Oe9qo8",

    authDomain:
      "qalb-e-deen-6af8e.firebaseapp.com",

    projectId:
      "qalb-e-deen-6af8e",

    storageBucket:
      "qalb-e-deen-6af8e.firebasestorage.app",

    messagingSenderId:
      "983132945914",

    appId:
      "1:983132945914:web:c4cd95d50a5259cbbdf843"

  };


  const app =
    initializeApp(firebaseConfig);


  const db =
    getFirestore(app);


  const auth =
    getAuth(app);


  const storage =
    getStorage(app);


  let currentUser = null;
  let allPosts = [];


  /* =========================
     SECURITY HTML
  ========================= */

  function escapeHtml(value = "") {

    return String(value).replace(
      /[&<>"']/g,
      ch => ({

        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#039;"

      }[ch])
    );

  }


  /* =========================
     DATE
  ========================= */

  function formatDate(value) {

    if(!value)
      return "তারিখ নেই";

    const d =
      value.toDate
        ? value.toDate()
        : new Date(value);

    return new Intl.DateTimeFormat(
      "bn-BD",
      {
        day:"numeric",
        month:"long",
        year:"numeric"
      }
    ).format(d);

  }


  /* =========================
     POSTS
  ========================= */

  function renderPosts(posts) {

    const featured =
      document.getElementById("featuredPost");

    const list =
      document.getElementById("postList");

    const status =
      document.getElementById("postStatus");


    if(!posts.length){

      featured.innerHTML = "";
      list.innerHTML = "";

      status.textContent =
        "এখনো কোনো published article নেই। Admin Panel থেকে প্রথম পোস্ট publish করুন।";

      status.style.display =
        "block";

      return;

    }


    status.style.display =
      "none";


    const first =
      posts[0];


    const firstImage =
      first.image ||
      "https://images.unsplash.com/photo-1609599006353-e629aaabfeae?auto=format&fit=crop&w=1000&q=85";


    featured.innerHTML = `

      <article class="post-card featured">

        <img
          src="${escapeHtml(firstImage)}"
          alt=""
        >

        <div class="post-body">

          <span class="tag">
            ${escapeHtml(first.category || "ইসলামিক জ্ঞান")}
          </span>

          <h4>
            ${escapeHtml(first.title || "Untitled")}
          </h4>

          <p>
            ${escapeHtml(first.excerpt || "")}
          </p>

          <div class="meta">

            <span>
              ◷ ${formatDate(first.createdAt)}
            </span>

            <span>
              ◉ ${Number(first.views || 0).toLocaleString("bn-BD")}
            </span>

          </div>

          <a
            class="btn"
            href="article.html?id=${encodeURIComponent(first.id)}"
          >
            বিস্তারিত পড়ুন →
          </a>

        </div>

      </article>

    `;


    list.innerHTML =
      posts.slice(1).map(post => {

        const image =
          post.image ||
          "https://images.unsplash.com/photo-1542816417-0983c9c9ad53?auto=format&fit=crop&w=600&q=80";


        return `

          <article class="list-card post-card">

            <img
              src="${escapeHtml(image)}"
              alt=""
            >

            <div class="post-body">

              <span class="tag">
                ${escapeHtml(post.category || "ইসলামিক জ্ঞান")}
              </span>

              <h4>
                ${escapeHtml(post.title || "Untitled")}
              </h4>

              <div class="meta">

                <span>
                  ◷ ${formatDate(post.createdAt)}
                </span>

                <span>
                  ◉ ${Number(post.views || 0).toLocaleString("bn-BD")}
                </span>

              </div>

              <a
                href="article.html?id=${encodeURIComponent(post.id)}"
                style="color:var(--green2);font-weight:700;font-size:13px"
              >
                পড়ুন →
              </a>

            </div>

          </article>

        `;

      }).join("");

  }


  /* =========================
     LOAD POSTS
  ========================= */

  const postsQuery =
    query(
      collection(db,"posts"),
      where("published","==",true),
      limit(30)
    );


  getDocs(postsQuery)

    .then(snapshot => {

      allPosts =
        snapshot.docs.map(
          document => ({
            id:document.id,
            ...document.data()
          })
        );


      allPosts.sort((a,b) => {

        const av =
          a.createdAt?.toMillis
            ? a.createdAt.toMillis()
            : new Date(a.createdAt || 0).getTime();


        const bv =
          b.createdAt?.toMillis
            ? b.createdAt.toMillis()
            : new Date(b.createdAt || 0).getTime();


        return bv - av;

      });


      renderPosts(allPosts);

    })

    .catch(error => {

      console.error(
        "Firestore public posts error:",
        error
      );


      document.getElementById(
        "postStatus"
      ).textContent =
        "পোস্ট লোড করা যায়নি। Firebase Rules পরীক্ষা করুন এবং page refresh করুন।";

    });


  /* =========================
     PROFILE AUTH
  ========================= */

  onAuthStateChanged(
    auth,
    async user => {

      currentUser =
        user;


      const profileInitial =
        document.getElementById(
          "profileInitial"
        );


      const profileImage =
        document.getElementById(
          "profileImage"
        );


      const loggedInArea =
        document.getElementById(
          "loggedInArea"
        );


      const loggedOutArea =
        document.getElementById(
          "loggedOutArea"
        );


      const profileName =
        document.getElementById(
          "profileName"
        );


      const profileEmail =
        document.getElementById(
          "profileEmail"
        );


      const profileLargeInitial =
        document.getElementById(
          "profileLargeInitial"
        );


      const profileLargeImage =
        document.getElementById(
          "profileLargeImage"
        );


      if(user){

        loggedOutArea.style.display =
          "none";

        loggedInArea.style.display =
          "block";


        let userData = {};


        /* Load user profile from Firestore */

        try{

          const userDoc =
            await getDoc(
              doc(db,"users",user.uid)
            );


          if(userDoc.exists()){

            userData =
              userDoc.data();

          }

        }catch(error){

          console.log(
            "Could not load user profile:",
            error
          );

        }


        const name =
          userData.displayName ||
          user.displayName ||
          "Qalb-e-Deen User";


        const photoURL =
          userData.photoURL ||
          user.photoURL ||
          "";


        profileName.textContent =
          name;


        profileEmail.textContent =
          user.email || "";


        const initial =
          name
            .trim()
            .charAt(0)
            .toUpperCase() || "U";


        if(photoURL){

          profileImage.src =
            photoURL;

          profileImage.style.display =
            "block";

          profileInitial.style.display =
            "none";


          profileLargeImage.src =
            photoURL;

          profileLargeImage.style.display =
            "block";

          profileLargeInitial.style.display =
            "none";

        }else{

          profileImage.style.display =
            "none";

          profileInitial.style.display =
            "block";

          profileInitial.textContent =
            initial;


          profileLargeImage.style.display =
            "none";

          profileLargeInitial.style.display =
            "block";

          profileLargeInitial.textContent =
            initial;

        }

      }else{

        loggedInArea.style.display =
          "none";

        loggedOutArea.style.display =
          "block";


        profileImage.style.display =
          "none";

        profileInitial.style.display =
          "block";

        profileInitial.textContent =
          "👤";

      }

    }
  );


  /* =========================
     PROFILE MENU
  ========================= */

  window.toggleProfileMenu =
    function(){

      document
        .getElementById("profileMenu")
        .classList.toggle("open");

    };


  /* =========================
     LOGIN
  ========================= */

  window.goToLogin =
    function(){

      window.location.href =
        "login.html";

    };


  /* =========================
     UPLOAD PROFILE PICTURE
  ========================= */

  window.uploadProfilePicture =
    async function(){

      if(!currentUser){

        alert(
          "প্রথমে Login করুন।"
        );

        return;

      }


      const fileInput =
        document.getElementById(
          "profileFile"
        );


      const file =
        fileInput.files[0];


      const status =
        document.getElementById(
          "uploadStatus"
        );


      if(!file){

        status.textContent =
          "প্রথমে একটি ছবি নির্বাচন করুন।";

        return;

      }


      /* Check image */

      if(!file.type.startsWith("image/")){

        status.textContent =
          "শুধু image file ব্যবহার করুন।";

        return;

      }


      /* Maximum 5MB */

      if(
        file.size >
        5 * 1024 * 1024
      ){

        status.textContent =
          "ছবির size সর্বোচ্চ 5MB হতে পারবে।";

        return;

      }


      try{

        status.textContent =
          "ছবি Upload হচ্ছে...";


        /*
          Firebase Storage path
        */

        const filePath =
          `profile-pictures/${currentUser.uid}/${Date.now()}-${file.name}`;


        const storageRef =
          ref(
            storage,
            filePath
          );


        await uploadBytes(
          storageRef,
          file
        );


        const photoURL =
          await getDownloadURL(
            storageRef
          );


        /*
          Save profile picture
          to Firestore
        */

        await setDoc(
          doc(
            db,
            "users",
            currentUser.uid
          ),
          {
            photoURL:photoURL,
            displayName:
              currentUser.displayName ||
              "Qalb-e-Deen User",
            email:
              currentUser.email || ""
          },
          {
            merge:true
          }
        );


        /*
          Update screen immediately
        */

        document.getElementById(
          "profileImage"
        ).src =
          photoURL;


        document.getElementById(
          "profileImage"
        ).style.display =
          "block";


        document.getElementById(
          "profileInitial"
        ).style.display =
          "none";


        document.getElementById(
          "profileLargeImage"
        ).src =
          photoURL;


        document.getElementById(
          "profileLargeImage"
        ).style.display =
          "block";


        document.getElementById(
          "profileLargeInitial"
        ).style.display =
          "none";


        status.textContent =
          "Profile picture সফলভাবে Upload হয়েছে ✓";


        fileInput.value =
          "";


      }catch(error){

        console.error(
          "Profile upload error:",
          error
        );


        status.textContent =
          "Upload failed। Firebase Storage Rules পরীক্ষা করুন।";

      }

    };


  /* =========================
     LOGOUT
  ========================= */

  window.logoutUser =
    async function(){

      try{

        await signOut(auth);


        document
          .getElementById("profileMenu")
          .classList.remove("open");


        alert(
          "আপনি সফলভাবে Logout করেছেন।"
        );


      }catch(error){

        console.error(error);

        alert(
          "Logout করা যায়নি।"
        );

      }

    };


  /* =========================
     SEARCH
  ========================= */

  window.searchPosts =
    function(){

      const q =
        document
          .getElementById("searchInput")
          .value
          .trim()
          .toLowerCase();


      if(!q){

        renderPosts(allPosts);

        document.getElementById(
          "searchResult"
        ).textContent = "";

        return;

      }


      const results =
        allPosts.filter(post =>

          `${post.title || ""}
           ${post.excerpt || ""}
           ${post.category || ""}`
            .toLowerCase()
            .includes(q)

        );


      document.getElementById(
        "searchResult"
      ).textContent =
        `“${q}” — ${results.length}টি পোস্ট পাওয়া গেছে।`;


      renderPosts(results);

    };


  /* =========================
     FOCUS SEARCH
  ========================= */

  window.focusSearch =
    function(){

      document
        .getElementById("searchInput")
        .focus();


      document
        .getElementById("searchWidget")
        .scrollIntoView({
          behavior:"smooth",
          block:"center"
        });

    };


  /* =========================
     NEWSLETTER
  ========================= */

  window.subscribe =
    function(){

      const email =
        document
          .getElementById("email")
          .value
          .trim();


      if(
        !email ||
        !email.includes("@")
      ){

        alert(
          "দয়া করে একটি সঠিক ইমেইল দিন।"
        );

        return;

      }


      alert(
        "ধন্যবাদ! Newsletter subscription-এর জন্য ইমেইলটি গ্রহণ করা হয়েছে।"
      );

    };


  /* =========================
     MOBILE MENU
  ========================= */

  window.toggleMenu =
    function(){

      document
        .getElementById("mobileNav")
        .classList.toggle("open");

    };


  /* =========================
     DARK MODE
  ========================= */

  window.toggleTheme =
    function(){

      document
        .body
        .classList
        .toggle("dark-mode");

    };


  /* =========================
     CLOSE PROFILE WHEN CLICKING OUTSIDE
  ========================= */

  document.addEventListener(
    "click",
    function(event){

      const profileArea =
        document.querySelector(
          ".profile-area"
        );


      if(
        profileArea &&
        !profileArea.contains(event.target)
      ){

        document
          .getElementById("profileMenu")
          .classList.remove("open");

      }

    }
  );

</script>

</body>
</html>
